# ElevenLabs API key (keep private; never commit .env)
ELEVENLABS_API_KEY=
# Set after creating and verifying a clone of YOUR OWN voice. Prefer PVC for final production.
ELEVENLABS_VOICE_ID=
# Eleven v4 uses Text-to-Dialogue with timestamps; multilingual v2 uses timestamped Text-to-Speech.
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_LANGUAGE_CODE=id
# Only applies to Professional Voice Clones fine-tuned for Eleven v4. Provider recommendation starts at 0.
ELEVENLABS_CLONE_STRENGTH=0.0
# Creator+ plans may use 192 kbps MP3; switch to mp3_44100_128 if your plan rejects it
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_192
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.82
# Used only by eleven_multilingual_v2; Eleven v4 uses Stability + Similarity.
ELEVENLABS_STYLE=0.20
ELEVENLABS_SPEAKER_BOOST=true
AUDIO_GAP_SECONDS=0.35
TARGET_LOUDNESS_LUFS=-14
TRUE_PEAK_DB=-1.5
FNVIDEO_OUTPUT_ROOT=out
# Optional: set if Playwright should use a system-installed Chromium binary
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
